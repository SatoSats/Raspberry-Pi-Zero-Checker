#!/usr/bin/env bash
set -u
pass() { printf '[OK]   %s\n' "$1"; }
warn() { printf '[INFO] %s\n' "$1"; }
fail() { printf '[NO]   %s\n' "$1"; }

if [[ ! -r /proc/cpuinfo && ! -r /proc/device-tree/model ]]; then
  echo 'Esegui questo programma sul Raspberry Pi.' >&2
  exit 2
fi
MODEL='sconosciuto'
[[ -r /proc/device-tree/model ]] && MODEL="$(tr -d '\000' </proc/device-tree/model)"
REVISION="$(awk -F': *' '/^Revision[[:space:]]*:/ {print tolower($2); exit}' /proc/cpuinfo 2>/dev/null || true)"
ARCH="$(dpkg --print-architecture 2>/dev/null || uname -m)"
OS_CODENAME='sconosciuto'
OS_PRETTY='sconosciuto'
OS_VERSION='sconosciuta'
if [[ -r /etc/os-release ]]; then
  . /etc/os-release
  OS_CODENAME="${VERSION_CODENAME:-sconosciuto}"
  OS_PRETTY="${PRETTY_NAME:-sconosciuto}"
  OS_VERSION="${VERSION_ID:-sconosciuta}"
fi

echo '=== Raspberry Pi Zero Checker ==='
printf 'Modello: %s\nRevisione: %s\n' "$MODEL" "${REVISION:-non disponibile}"
printf 'Sistema: %s\nVersione: %s | codename: %s | architettura: %s\n' "$OS_PRETTY" "$OS_VERSION" "$OS_CODENAME" "$ARCH"
printf 'Kernel: %s\nMemoria: %s\n' "$(uname -r)" "$(awk '/MemTotal/ {printf "%.0f MB", $2/1024}' /proc/meminfo 2>/dev/null || echo non disponibile)"
echo

status=0
if [[ "$MODEL" == *'Raspberry Pi Zero'* && "$REVISION" =~ ^(900093|920093)$ ]]; then
  pass 'Modello e revisione corrispondono a Raspberry Pi Zero V1.3.'
elif [[ "$MODEL" == *'Raspberry Pi Zero'* ]]; then
  warn 'Rilevato un Pi Zero, ma la revisione non corrisponde alla V1.3 attesa.'
  status=1
else
  fail 'Il sistema non identifica un Raspberry Pi Zero V1.3.'
  status=1
fi
if [[ "$OS_CODENAME" == trixie && "$ARCH" == armhf ]]; then
  pass 'Raspberry Pi OS Trixie a 32 bit rilevato.'
else
  warn 'Sistema o architettura diversi dal profilo Trixie 32-bit.'
  status=1
fi
if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet ssh; then
  pass 'Servizio SSH attivo.'
else
  warn 'Servizio SSH non risulta attivo.'
  status=1
fi
if ip link show usb0 >/dev/null 2>&1; then
  pass 'Interfaccia USB Gadget usb0 presente.'
else
  warn 'Interfaccia usb0 assente; controlla USB Gadget e cavo dati.'
  status=1
fi
echo
if [[ "$status" -eq 0 ]]; then
  echo 'Esito software: controlli previsti superati.'
  echo 'Non sostituisce il collaudo fisico e non certifica autenticità.'
else
  echo 'Esito software: controlli da approfondire. Consulta la guida PDF.'
fi
exit "$status"
