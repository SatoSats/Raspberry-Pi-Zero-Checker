#!/usr/bin/env bash
set -u

pass() { printf '[OK]   %s\n' "$1"; }
info() { printf '[INFO] %s\n' "$1"; }
fail() { printf '[NO]   %s\n' "$1"; }

if [[ ! -r /proc/cpuinfo && ! -r /proc/device-tree/model ]]; then
  echo 'Esegui questo programma sul Raspberry Pi.' >&2
  exit 2
fi

MODEL='sconosciuto'
[[ -r /proc/device-tree/model ]] && MODEL="$(tr -d '\000' </proc/device-tree/model)"
REVISION="$(awk -F': *' '/^Revision[[:space:]]*:/ {print tolower($2); exit}' /proc/cpuinfo 2>/dev/null || true)"
ARCH="$(dpkg --print-architecture 2>/dev/null || uname -m)"
OS_CODENAME='sconosciuto'
OS_PRETTY='sconosciuto'
OS_VERSION='sconosciuta'
if [[ -r /etc/os-release ]]; then
  . /etc/os-release
  OS_CODENAME="${VERSION_CODENAME:-sconosciuto}"
  OS_PRETTY="${PRETTY_NAME:-sconosciuto}"
  OS_VERSION="${VERSION_ID:-sconosciuta}"
fi

echo '=== Raspberry Pi Zero Checker ==='
printf 'Modello: %s\nRevisione: %s\n' "$MODEL" "${REVISION:-non disponibile}"
printf 'Sistema: %s\nVersione: %s | codename: %s | architettura: %s\n' "$OS_PRETTY" "$OS_VERSION" "$OS_CODENAME" "$ARCH"
printf 'Kernel: %s\nMemoria: %s\n' "$(uname -r)" "$(awk '/MemTotal/ {printf "%.0f MB", $2/1024}' /proc/meminfo 2>/dev/null || echo non disponibile)"
echo

status=0
if [[ "$MODEL" == *'Raspberry Pi Zero'* && "$REVISION" =~ ^(900093|920093)$ ]]; then
  pass 'Modello e revisione compatibili con Raspberry Pi Zero V1.3.'
else
  fail 'Modello o revisione diversi dal profilo Raspberry Pi Zero V1.3 atteso.'
  status=1
fi

if [[ "$OS_CODENAME" == trixie && "$ARCH" == armhf ]]; then
  pass 'Raspberry Pi OS Trixie a 32 bit (armhf) rilevato.'
else
  fail 'Sistema o architettura diversi da Raspberry Pi OS Trixie 32 bit (armhf).'
  status=1
fi

info 'SSH è escluso dal criterio di superamento.'
if command -v ip >/dev/null 2>&1 && ip link show usb0 >/dev/null 2>&1; then
  info 'Interfaccia USB Gadget usb0 presente; la verifica della rete host è separata.'
else
  info 'Interfaccia usb0 assente; USB Gadget e rete sono controlli facoltativi separati.'
fi

echo
if [[ "$status" -eq 0 ]]; then
  echo 'Esito test di riconoscimento: SUPERATO.'
else
  echo 'Esito test di riconoscimento: NON SUPERATO.'
fi
echo 'Il rapporto descrive dati software; non certifica l’autenticità fisica della scheda.'
echo 'Revisione e device-tree sono dati software falsificabili.'
exit "$status"
